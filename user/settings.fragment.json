{
  "_comment": "factory-core user settings (spec: User config). user/apply.py unions 'apply' into ~/.claude/settings.json and only reports drift for 'check'.",
  "apply": {
    "permissions": {
      "deny": [
        "Read(./.env*)",
        "Read(**/.env*)",
        "Read(**/*.pem)",
        "Read(~/.aws/**)",
        "Read(~/.config/gcloud/**)",
        "Read(~/.ssh/**)",
        "Read(~/.config/gh/**)",
        "Read(~/AppData/Roaming/GitHub CLI/**)",
        "Read(~/.git-credentials)",
        "Bash(git push --force*)",
        "Bash(git push -f*)",
        "Bash(git push * --force*)",
        "Bash(git push * -f*)",
        "Bash(git reset --hard origin/*)",
        "Bash(gh pr merge*)",
        "Bash(gh secret*)",
        "Bash(gh ruleset*)",
        "Bash(gh workflow run*)",
        "Bash(gh api * -X DELETE*)",
        "Bash(gh api * --method DELETE*)",
        "Bash(gh api *rulesets*)",
        "Bash(gh api *dispatches*)",
        "Bash(wrangler deploy*)",
        "Bash(railway up*)",
        "Bash(rm -rf /*)",
        "Bash(rm -rf ~*)"
      ]
    }
  },
  "check": {
    "permissions": {"defaultMode": "auto"},
    "model": "opus",
    "modelSettings": {"claude-opus-5-5": {"effortLevel": "high"}}
  },
  "agents": {"mechanical-editor": {"model": "sonnet"}}
}
