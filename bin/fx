#!/usr/bin/env python3
"""fx: the factory CLI (spec: Design > fx). Every refusal prints its cause and one "Next:" line (D10)."""
import argparse, json, os, re, shlex, shutil, subprocess, sys, time
from pathlib import Path

CORE = Path(__file__).resolve().parents[1]
if sys.version_info < (3, 11):
    sys.exit(f"fx: needs Python 3.11 or newer (this is {sys.version.split()[0]}).\nNext: run fx with Python 3.11+")
sys.path[:0] = [str(CORE / "plugins" / "factory" / "lib"), str(CORE / "ci")]
import factory_lib as fl  # noqa: E402
import gates, tier  # noqa: E402

LABEL, PR_FIELDS = gates.LABEL, "number,url,state,headRefName,labels"

class Refused(Exception):
    pass

def refuse(cause, nxt):
    raise Refused(f"{cause}\nNext: {nxt}")

def run(cmd, cwd=None, env=None):
    r = subprocess.run([str(c) for c in cmd], cwd=cwd, env=env, capture_output=True, text=True, encoding="utf-8", errors="replace")
    if r.returncode:
        refuse(f"`{' '.join(map(str, cmd[:3]))}` failed: {(r.stderr or r.stdout).strip()[-600:]}", "fix the cause above, then rerun")
    return r.stdout.strip()

def gh_json(*args, cwd=None):
    return json.loads(run(["gh", *args], cwd) or "null")

def slug(title):
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:40].strip("-") or "issue"  # non-ASCII titles

def names(cfg, n, title, labels):  # -> (branch, worktree dir name) from the config patterns
    types = [lb["name"][5:] for lb in labels if lb["name"].startswith("type:")]
    typ = next((t for t in types if t in cfg["branch_types"]), (cfg["branch_types"] or [""])[0])
    f = {"issue": n, "slug": slug(title), "type": typ, "project": cfg["project"]}
    return cfg["branch"].format(**f), cfg["worktree_name"].format(**f)

def label_tier(labels, default=1):
    got = [tier.tier_num(lb["name"][5:]) for lb in labels if lb["name"].startswith("tier:")]
    return max([t for t in got if t is not None], default=default)

def resolve(ref, cwd="."):  # <n> = the current git root's repo; <key>#<n> = [workspace] repos.<key> -> (ctx, n, key)
    ctx = fl.repo_ctx(cwd)
    m = re.fullmatch(r"(?:([\w.-]+)#)?(\d+)", str(ref)) if ref is not None else None
    if ref is None:
        return (ctx, ctx["issue"], None) if ctx and ctx["issue"] else refuse("not in a factory worktree", "pass the issue: fx ship <id>")
    if not m:
        refuse(f"bad ref {ref!r}", "use <n>, or <key>#<n> from the workspace root")
    key, n = m.groups()
    if ctx and key:
        r = ((ctx["cfg"] or {}).get("workspace") or {}).get("repos", {}).get(key)
        if not r:
            refuse(f"no [workspace] repos.{key} in {ctx['root']}", "run fx from the workspace root, or pass <n> inside the repo")
        ctx = fl.repo_ctx(ctx["root"] / r["path"])
    if not ctx or not ctx["repo"]:
        refuse(f"{Path(cwd).resolve()} is not a factory repo (needs a github.com origin)", "cd into the repo or the workspace root")
    return ctx, n, key

def main_root(root):
    return Path(fl.git(root, "rev-parse", "--path-format=absolute", "--git-common-dir") or Path(root) / ".git").parent

def worktrees(ctx):  # {issue: path} for linked worktrees on a branch matching the config pattern
    out, path, first = {}, None, True
    for ln in (fl.git(ctx["root"], "worktree", "list", "--porcelain") or "").splitlines():
        if ln.startswith("worktree "):
            path, first = (Path(ln[9:]), path is None)
        elif ln.startswith("branch refs/heads/") and (not first or os.environ.get("FACTORY_NEXT")) and (i := fl.parse_issue(ctx["cfg"]["branch"], ln[18:])):
            out[i] = path
    return out

def worktree_ctx(ref):
    ctx, n, key = resolve(ref)
    wt = worktrees(ctx).get(n) or refuse(f"no worktree for #{n} in {ctx['repo']}", f"fx shape {ref or n}")
    return fl.repo_ctx(wt), n, ref or n

def spec_file(root, cfg, n):  # the spec under specs_dir whose frontmatter id == n (T2/T3)
    for p in sorted((root / cfg["specs_dir"]).glob("*.md")):
        try:
            if str(fl.load_spec(p)[0].get("id")) == str(n):
                return p.relative_to(root).as_posix()
        except ValueError:
            continue

def open_pr(w):
    prs = gh_json("pr", "list", "-R", w["repo"], "--head", w["branch"], "--state", "open", "--json", "number,url")
    return (prs or [None])[0]

def launch(w, prompt, phase):  # returns at once: a background session, the user's own model and settings (D23)
    if nxt := os.environ.get("FACTORY_NEXT"):  # GitHub Actions (templates/factory-agent.yml): its next step runs this
        Path(nxt).write_text(prompt, "utf-8"); print(f"Next {phase} prompt written to {nxt}"); return 0
    p = subprocess.run([shutil.which("claude") or "claude", "--bg", prompt], cwd=w["root"], capture_output=True, text=True,
                       encoding="utf-8", errors="replace", env=os.environ | {"FACTORY_PHASE": phase})
    sid = re.search(r"backgrounded\W+([\w-]+)", p.stdout) or refuse(
        f"claude --bg did not start: {(p.stderr or p.stdout).strip()[-600:]}", f"fix the cause above, then rerun fx {phase}")
    if w["work"]:  # fx clean stops them: an idle session holds its folder on Windows
        fl.save_state(w, sessions=[*w["state"].get("sessions", []), sid[1]])
    print(f"Started the {phase} session in the background.\nWatch: claude attach {sid[1]}  (or claude logs {sid[1]})")
    return 0

def ledger(w, url):
    st = w["state"]
    run([sys.executable, CORE / "metrics" / "ledger.py", "append", "--repo", w["repo"], "--issue", w["issue"],
         "--tier", st.get("tier", 1), "--branch", w["branch"], "--worktree", w["root"], "--pr", url,
         *(["--parent", st["parent"]] if st.get("parent") else [])], w["root"])

EDITS = ("query($o: String!, $r: String!, $n: Int!) { repository(owner: $o, name: $r) { issue(number: $n) "
         "{ userContentEdits(last: 100) { nodes { editedAt editor { login } } } } } }")  # REST has no body edit history

def intake(repo, n, iss, cfg, cmd):  # G6: act only on the owner's issues, or on ones the owner or approver marked ready
    me, labels, author = os.environ.get("FACTORY_OWNER") or run(["gh", "api", "user", "--jq", ".login"]), {lb["name"] for lb in iss["labels"]}, \
        (iss.get("author") or {}).get("login") or "someone else"
    if "triage" in labels or author.lower() != me.lower():  # logins are case-insensitive
        who = sorted({me, cfg["authority"]["approver"]} - {""}, key=str.lower)
        ok, again = {x.lower() for x in who}, f"as {' or '.join(who)}, remove the ready label from #{n} and add it again"
        ev = run(["gh", "api", "--paginate", f"repos/{repo}/issues/{n}/events", "--jq", '.[] | select(.event == "labeled"'
                  ' and .label.name == "ready") | .actor.login + " " + .created_at']).split()
        by, at = (ev[-2].lower(), ev[-1]) if ev else ("", "")
        if "ready" not in labels or by not in ok:  # the latest `ready` decides, and it must still be on
            why = "is labelled triage" if "triage" in labels else f"was opened by {author}"
            refuse(f"#{n} {why}, and the owner hasn't marked it ready (G6)", f"{again}, then fx {cmd} {n}" if "ready" in
                   labels else f"as {' or '.join(who)}, add the ready label to #{n}, then fx {cmd} {n}")
        o, r = repo.split("/")
        edits = run(["gh", "api", "graphql", "-F", f"n={n}", "-f", f"o={o}", "-f", f"r={r}", "-f", f"query={EDITS}", "--jq",
                     '.data.repository.issue.userContentEdits.nodes[] | (.editor.login // "ghost") + " " + .editedAt'])
        if late := sorted({e.split()[0] for e in edits.splitlines() if e.split()[1] > at and e.split()[0].lower() not in ok}):
            refuse(f"#{n} was edited by {', '.join(late)} after it was marked ready (G6)",
                   f"read #{n} again; if it is still right, {again}, then fx {cmd} {n}")

def cmd_shape(a):
    ctx, n, _ = resolve(a.ref)
    cfg, repo = ctx["cfg"], ctx["repo"]
    iss = gh_json("issue", "view", n, "-R", repo, "--json", "title,labels,body,author")
    intake(repo, n, iss, cfg, "shape")
    if "workspace" in cfg and "factory:parent" in {lb["name"] for lb in iss["labels"]}:
        refuse(f"#{n} is a workspace parent: /factory:idea split it into slices", "fx shape <key>#<slice> for each slice")
    main = main_root(ctx["root"])
    if not os.environ.get("FACTORY_NEXT"):  # A4: in Actions the checkout fetched it all, and keeps no credential
        run(["git", "fetch", "origin"], main)
    if not fl.git(main, "rev-parse", "--verify", "--quiet", "origin/HEAD"):  # the default branch, not a hard-coded main
        fl.git(main, "remote", "set-head", "origin", "--auto")
        if not fl.git(main, "rev-parse", "--verify", "--quiet", "origin/HEAD"):
            refuse(f"{repo} has no default branch yet (an empty repo)", f"push a first commit, then fx shape {a.ref}")
    if fl.git(main, "check-ignore", "-q", ".factory/work/x") is None:  # no gitignore covers the work dir
        ex = Path(fl.git(main, "rev-parse", "--path-format=absolute", "--git-common-dir")) / "info" / "exclude"
        ex.parent.mkdir(exist_ok=True)
        with open(ex, "a", encoding="utf-8", newline="") as f:  # LF, as git writes it
            f.write("\n.factory/work/\n")
    branch, wname = names(cfg, n, iss["title"], iss["labels"])
    wt = worktrees(ctx).get(n) or (main / cfg["worktree_root"].format(project=cfg["project"])).resolve() / wname
    if os.environ.get("FACTORY_NEXT"):  # the action runs in the checkout, not a worktree
        wt = main
        base = f"origin/{branch}" if fl.git(main, "rev-parse", "--verify", "--quiet", f"origin/{branch}") else "origin/HEAD"
        if fl.git(main, "branch", "--show-current") != branch: run(["git", "checkout", "-B", branch, base], main)  # a rerun
    if not wt.exists():
        has = fl.git(main, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}")
        run(["git", "worktree", "add", wt, branch] if has else ["git", "worktree", "add", "-b", branch, wt, "origin/HEAD"], main)
    m, w = re.search(r"^Parent: (\S+#\d+)\s*$", iss.get("body") or "", re.M), fl.repo_ctx(wt)
    fl.save_state(w, issue=n, repo=repo, branch=branch, worktree=str(wt), parent=m and m.group(1),
                  phase="shape", tier=label_tier(iss["labels"]), fx=(CORE / "bin" / "fx").as_posix())  # shape's PATH fallback
    cmd = shlex.split(cfg["setup"]) if isinstance(cfg["setup"], str) else cfg["setup"]  # an argv list or one string
    if cmd and not w["state"].get("setup_done"):  # once per worktree, e.g. install dependencies
        print(f"Setting up the worktree: {' '.join(cmd)}", flush=True)
        run([shutil.which(cmd[0]) or cmd[0], *cmd[1:]], wt,  # which: npm/pnpm are .cmd shims on Windows; A4: no token
            {k: v for k, v in os.environ.items() if k not in ("GH_TOKEN", "GITHUB_TOKEN")})
        fl.save_state(w, setup_done=True)
    return launch(w, f"/factory:shape {n}", "shape")

def cmd_build(a):
    w, n, ref = worktree_ctx(a.ref)
    cfg, wt, rel = w["cfg"], w["root"], f".factory/work/{n}"
    iss = gh_json("issue", "view", n, "-R", w["repo"], "--json", "title,labels,body,author")
    intake(w["repo"], n, iss, cfg, "build")  # again: the build reads the body, which may have changed since shape
    spec = spec_file(wt, cfg, n)
    t = max(label_tier(iss["labels"], w["state"].get("tier", 1)), tier.tier_num(spec and fl.load_spec(wt / spec)[0].get("tier")) or 0)
    if t >= 2:  # a T3 spec is approved on the PR (I7), not before the build
        spec_path = spec or refuse(f"T{t} needs a spec file under {cfg['specs_dir']} with id = {n}", f"fx shape {ref}")
    elif t == 1:
        spec_path = f"{rel}/spec.md"  # always rewritten: the issue's block is the T1 spec
        block = fl.extract_block(iss["body"]) or refuse(f"issue #{n} has no factory:spec block", f"fx shape {ref}")
        (wt / spec_path).write_text(block + "\n", "utf-8")
    else:
        spec_path = f"{rel}/intent.md"
        (wt / spec_path).write_text(f"# {iss['title']}\n\n{(iss['body'] or '').strip()}\n", "utf-8")
    fl.save_state(w, phase="build", tier=t, spec_path=spec_path)
    notes = p.relative_to(wt).as_posix() if (p := fl.notes_path(w)).is_relative_to(wt) else str(p)  # a user path may sit outside
    bg = os.environ.get("FACTORY_NEXT") and "in the foreground, subagents too (Bash timeout up to 600000): the run ends at its first wait"
    return launch(w, f"Implement the spec in {spec_path}, unattended: nobody is watching. Keep {notes} current. Run"
                  " `fx verify --fast` and `fx ship` " + (bg or "with the Bash tool's run_in_background, and wait for their result") + "."
                  " Show the change working the way your setup says, end to end where it is user-facing. Run the reviews"
                  f" your setup requires for T{t}, or for the PR's factory/tier once CI computes a higher one. If it names"
                  " none: at T2 and up one independent review in a fresh context given only the spec and the diff, at T3"
                  " also a security review. Fix the findings you can demonstrate with a failing test and"
                  f" list the rest under Needs you. Then write {rel}/packet.md from {CORE.as_posix()}/plugins/factory/"
                  f"templates/packet.md using this repo's [packet] headings, with what you exercised, and run `fx ship {n}`."
                  f" Then make the PR's checks pass. If `fx` is not on PATH, run {CORE.as_posix()}/bin/fx. When"
                  " a failure repeats past your setup's limit (3 if none), or the next step is irreversible or needs the"
                  f" owner, write a `## Blocker` section in {notes} with the question, post it as an issue comment, and stop."
                  " Rename a Blocker the owner has answered to `## Blocker (resolved)`. Never add the spec-approved"
                  " label: only the owner approves a spec.",
                  "build")

def cmd_verify(a):
    ctx = fl.repo_ctx(".")
    if not ctx or not ctx["cfg"]:
        refuse("not in a github.com repo or a repo with .factory/config.toml", "cd into a factory worktree")
    res = fl.run_verify(ctx, "full" if a.full else "fast")
    print("\n".join(res["lines"] + ([] if res["ok"] else [res["tail"]])))
    state = "ok" if res["ok"] else f"FAIL ({res['reason']}: {', '.join(res['failed'])})"
    print(f"{state}{' (over budget)' if res['over_budget'] else ''}; total {res['seconds']:.0f}s")
    return 0 if res["ok"] else 1

def cmd_ship(a):
    w, n, _ = worktree_ctx(a.id)
    cfg, work, t, stage = w["cfg"], w["work"], int(w["state"].get("tier", 1)), "packet"
    pr = open_pr(w)
    try:
        text = (work / "packet.md").read_text("utf-8") if (work / "packet.md").is_file() else ""
        if probs := (fl.packet_check(text, cfg, t) if text else ["no packet.md"]):
            refuse(f"{work / 'packet.md'}: " + "; ".join(probs), f"fix packet.md, then fx ship {n}")
        if dirty := fl.git(w["root"], "status", "--porcelain", "-uno"):  # verified, but the push would leave them out
            refuse("uncommitted changes: " + ", ".join(ln.split(maxsplit=1)[-1] for ln in dirty.splitlines()[:5]), f"commit them, then fx ship {n}")
        fl.save_state(w, ship="running")
        res = fl.run_verify(w, "full")
        fl.log("fx_ship", w, decision="ship" if res["ok"] else "refuse", reason=res["reason"], verify_ok=res["ok"])
        if not res["ok"]:
            stage = ",".join(res["failed"])
            refuse(f"verify --full failed ({res['reason']}: {stage})\n{res['tail']}", f"fix it, then fx ship {n}")
        stage = "push"
        run(["git", "push", "-u", "origin", w["branch"]], w["root"])
        ev = "\n".join([f"Recorded by `fx ship` (verify --full at `{fl.git(w['root'], 'rev-parse', 'HEAD')}`):",  # D27 (B4)
                        *[f"- `{ln}`" for ln in res["lines"]]])
        (work / "pr_body.md").write_text(f"{text.rstrip()}\n\n{ev}\n\nCloses #{n}\n", "utf-8")
        bf, repo = ["--body-file", work / "pr_body.md"], ["-R", w["repo"]]
        if pr:
            run(["gh", "pr", "edit", pr["number"], *repo, *bf], w["root"])
        title = None if pr else gh_json("issue", "view", n, *repo, "--json", "title")["title"]
        url = pr["url"] if pr else run(["gh", "pr", "create", *repo, "--head", w["branch"], "--title", title, *bf,
                                        "--label", f"tier:T{t}"], w["root"]).splitlines()[-1]
    except Refused:
        fl.save_state(w, ship=f"failed:{stage}")
        raise
    fl.save_state(w, pr=url, ship="ok")
    ledger(w, url)
    print(url)
    print(f"Next: as {cfg['authority']['approver'] or 'the approver'}, review the spec on {url} and add label {LABEL}."
          if t >= 3 else "Next: wait for CI; fx lists the PR under Waiting on you.")

def cmd_ledger(a):
    ctx = fl.repo_ctx(".")
    if not ctx or not ctx["work"]:
        refuse("not in a factory worktree", "cd into the worktree of the shipped issue")
    ledger(ctx, a.pr)

def cmd_clean(a):
    w, n, ref = worktree_ctx(a.ref)
    pr = gh_json("pr", "view", w["state"].get("pr") or w["branch"], "-R", w["repo"], "--json", "state,url")
    if pr["state"] != "MERGED":
        refuse(f"{pr['url']} is {pr['state'].lower()}, not merged", f"the owner merges it, then fx clean {ref}")
    clean(w, n, pr["url"])

def clean(w, n, url):  # archive the notes and packet, stop the sessions, remove the worktree and branch
    ledger(w, url)  # replaces the row, so review fixes after ship are counted
    arch = fl.home() / "archive" / w["repo"] / n
    arch.mkdir(parents=True, exist_ok=True)
    for f in (fl.notes_path(w), w["work"] / "packet.md"):
        if f.is_file():
            shutil.copy2(f, arch / f.name)
    main = main_root(w["root"])
    os.chdir(main)  # Windows can't delete the folder fx runs in
    claude, ids = shutil.which("claude") or "claude", set(w["state"].get("sessions", []))
    for s in sorted(ids):  # idle background sessions; one already gone is fine
        subprocess.run([claude, "stop", s], capture_output=True)
    for _ in range(40 if ids else 0):  # stop returns before the session exits and frees the folder on Windows
        out = subprocess.run([claude, "agents", "--json"], capture_output=True, text=True, encoding="utf-8", errors="replace")
        if not any(s in out.stdout for s in ids):  # plain text match: survives warnings or a changed JSON shape
            break
        time.sleep(0.5)
    run(["git", "worktree", "remove", w["root"]], main)  # refuses when the worktree has changes
    run(["git", "branch", "-D", w["branch"]], main)  # only because GitHub says the PR is merged
    print(f"Cleaned #{n}: archived to {arch}; removed {w['root']} and branch {w['branch']}.")

def collect(cwd="."):  # [{key, cfg, repo, wts: {issue: {path, state}}, prs}] in workspace order
    ctx = fl.repo_ctx(cwd)
    if not ctx or not ctx["cfg"]:
        refuse("not in a github.com repo, or a workspace with .factory/config.toml", "cd into one")
    ws = ctx["cfg"].get("workspace")
    out = []
    for k in (ws.get("order") or list(ws["repos"])) if ws else [None]:
        c = fl.repo_ctx(ctx["root"] / ws["repos"][k]["path"]) if k else ctx
        if c and c["cfg"]:
            wts = {i: {"path": p, "state": fl.load_json(p / ".factory" / "work" / i / "state.json", {})}
                   for i, p in worktrees(c).items()}
            prs = gh_json("pr", "list", "-R", c["repo"], "--state", "all", "--limit", "100", "--json", PR_FIELDS) if c["repo"] else []
            out.append({"key": k, "cfg": c["cfg"], "repo": c["repo"], "wts": wts, "prs": prs or []})
    return out

def ref_of(r, i):
    return f"{r['key']}#{i}" if r["key"] else str(i)

def table(repos):
    rows = [("issue", "tier", "phase", "last verify", "PR", "ship")]
    for r in repos:
        for i, w in sorted(r["wts"].items(), key=lambda x: int(x[0])):
            st, lv = w["state"], w["state"].get("last_verify") or {}
            v = (f"{'ok' if lv['ok'] else 'red ' + ','.join(lv.get('failed', []))} {lv.get('mode')} {lv.get('seconds', 0):.0f}s"
                 f"{' over budget' if lv.get('over_budget') else ''}") if lv else "-"
            rows.append((ref_of(r, i), f"T{st.get('tier', '?')}", st.get("phase", "-"), v, st.get("pr") or "-", st.get("ship") or "-"))
    wid = [max(len(str(x[c])) for x in rows) for c in range(6)]
    return "\n".join("  ".join(str(x[c]).ljust(wid[c]) for c in range(6)).rstrip() for x in rows)

def waiting(repos):  # the "Waiting on you" list; approver and order come from config, never hard-coded
    out, first = [], repos[0] if repos else {"prs": []}
    first_open = {p["url"] for p in first["prs"] if p["state"] == "OPEN"}
    for r in repos:
        who, by_url = r["cfg"]["authority"]["approver"] or "the approver", {p["url"]: p for p in r["prs"]}
        by_head = {w["state"].get("branch"): w["state"] for w in r["wts"].values()}
        for p in r["prs"]:
            if p["state"] != "OPEN" or not fl.parse_issue(r["cfg"]["branch"], p["headRefName"]):
                continue
            if (st := by_head.get(p["headRefName"]) or {}).get("tier") == 3 and LABEL not in {lb["name"] for lb in p["labels"]}:  # I7: a declared T3
                out.append(f"as {who}, add `{LABEL}`: {p['url']}")
                continue
            par = st.get("parent")
            dep = r is not first and par and next((w["state"]["pr"] for w in first["wts"].values()
                                                   if w["state"].get("parent") == par and w["state"].get("pr") in first_open), None)
            out.append(f"merge {first['key']} PR {dep} first: {p['url']}" if dep else f"review/merge: {p['url']}")
        for i, w in sorted(r["wts"].items()):
            st, prog = w["state"], fl.notes_path({"root": Path(w["path"]), "issue": i})
            if str(st.get("ship", "")).startswith("failed:"):
                out.append(f"{ref_of(r, i)}: ship failed at {st['ship'][7:]}. Next: `fx build {ref_of(r, i)}`")
            if prog.is_file() and fl.BLOCKER.search(prog.read_text("utf-8", "replace")):
                out.append(f"unblock: {prog}")
            if by_url.get(st.get("pr"), {}).get("state") == "MERGED":
                out.append(f"`fx clean {ref_of(r, i)}`")
    return out

def drift():  # SP1: the installed plugin is a cache copy, so core edits need `claude plugin update`
    src = CORE / "plugins" / "factory"
    files = lambda d: {p.relative_to(d).as_posix(): p.read_bytes() for p in d.rglob("*") if p.is_file() and "__pycache__" not in p.parts}  # noqa: E731
    for e in (fl.load_json(Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude") / "plugins" / "installed_plugins.json", {}).get("plugins") or {}).get("factory@factory-core", []):
        inst = Path(e.get("installPath") or "")
        if inst.is_dir() and inst.resolve() != src.resolve() and files(inst) != files(src):
            return f"warning: the installed factory plugin ({inst}) differs from {src}.\nNext: claude plugin update factory@factory-core"

def cmd_status(a):
    repos = collect()
    for r in repos if a.cmd is None else []:  # bare fx only: clean merged worktrees with a clean tree; dirty ones stay listed
        merged = {p["url"] for p in r["prs"] if p["state"] == "MERGED"}
        for i, w in list(r["wts"].items()):
            if w["state"].get("pr") in merged and fl.git(w["path"], "status", "--porcelain") == "":
                try:
                    clean(fl.repo_ctx(w["path"]), i, w["state"]["pr"])
                    del r["wts"][i]
                except Refused as e:
                    print(f"fx: could not clean {ref_of(r, i)}: {e}", file=sys.stderr)
    print(table(repos) + "\n\nWaiting on you:" + ("".join(f"\n- {x}" for x in waiting(repos)) or " nothing"))
    if d := drift():
        print("\n" + d)

def main(argv=None):
    p = argparse.ArgumentParser(prog="fx", description="factory CLI (Phase 1, local only)")
    sub = p.add_subparsers(dest="cmd")
    for name, pos, flags in (("status", [], []), ("shape", ["ref"], []), ("build", ["ref"], []), ("clean", ["ref"], []),
                             ("verify", [], ["--fast", "--full"]), ("ship", ["id?"], [])):
        sp = sub.add_parser(name)
        for x in pos:
            sp.add_argument(x.rstrip("?"), nargs="?" if x.endswith("?") else None)
        for x in flags:
            sp.add_argument(x, action="store_true")
    sub.add_parser("ledger").add_argument("--pr", required=True)
    a = p.parse_args(argv)
    try:
        return globals()[f"cmd_{a.cmd or 'status'}"](a) or 0
    except Refused as e:
        print(f"fx {a.cmd or 'status'}: {e}", file=sys.stderr)
        return 1

if __name__ == "__main__":
    for stream in (sys.stdout, sys.stderr):
        stream.reconfigure(encoding="utf-8", errors="replace")  # type: ignore[attr-defined]
    sys.exit(main())
